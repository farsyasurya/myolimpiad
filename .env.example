# Template Konfigurasi Firebase untuk Web Game Edukasi Olimpiade
# Salin file ini menjadi .env dan masukkan konfigurasi project Firebase Anda dari Firebase Console:
# Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration -> Config

VITE_FIREBASE_API_KEY=AIzaSyDummyApiKeyForTemplate12345
VITE_FIREBASE_AUTH_DOMAIN=olimpiad-math-edu.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=olimpiad-math-edu
VITE_FIREBASE_STORAGE_BUCKET=olimpiad-math-edu.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
